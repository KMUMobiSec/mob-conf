# -----------------------------------------------------------------------------
# Proceedings [OPTIONAL]
# -----------------------------------------------------------------------------
# Static password to access the online proceedings pages.
# When set, users must enter this password to view proceedings.
# Acts as the shared/default password across all years.
PROCEEDINGS_PASSWORD=mobisec@25

# Per-year overrides. When set, they take precedence over PROCEEDINGS_PASSWORD
# for that year, so each edition can have its own password.
PROCEEDINGS_PASSWORD_2025=mobisec@25
PROCEEDINGS_PASSWORD_2026=mobisec@26

# Secret for signing the proceedings auth cookie. Defaults to the year's password
# if unset. Optional per-year override: PROCEEDINGS_SECRET_<year>.
# PROCEEDINGS_SECRET=

# =============================================================================
# Xylvir Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values
# Required variables are marked with [REQUIRED]
# Optional variables are marked with [OPTIONAL]
# =============================================================================

# -----------------------------------------------------------------------------
# Database [REQUIRED]
# -----------------------------------------------------------------------------
# PostgreSQL connection URL
DATABASE_URL=""

# -----------------------------------------------------------------------------
# API Configuration [REQUIRED]
# -----------------------------------------------------------------------------
# Base URL for API routes
API_URL=http://localhost:3000/api

# -----------------------------------------------------------------------------
# Better Auth [REQUIRED]
# -----------------------------------------------------------------------------
# Secret key for authentication (minimum 32 characters)
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=your-secret-key-minimum-32-characters-long

# Base URL for authentication callbacks
BETTER_AUTH_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Frontend [REQUIRED]
# -----------------------------------------------------------------------------
# Public base URL (used for client-side navigation)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Admin Bootstrap [OPTIONAL]
# -----------------------------------------------------------------------------
# Optional one-time inputs for non-interactive pnpm admin:create.
# If omitted, the CLI prompts for email and password.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=MOBISEC Admin

# -----------------------------------------------------------------------------
# Supabase Storage [REQUIRED FOR STORAGE]
# -----------------------------------------------------------------------------
# Supabase project URL
SUPABASE_URL=

# Supabase anon key. Do not use this for privileged server storage operations.
SUPABASE_ANON_KEY=

# Supabase service role key. Server-only; never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Public Supabase values used by browser realtime subscriptions.
# These are safe to expose and are required for admin QR check-in realtime updates.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# -----------------------------------------------------------------------------
# Error Tracking (Sentry) [OPTIONAL]
# -----------------------------------------------------------------------------
# Sentry DSN for error tracking
# Get this from your Sentry project settings
# Leave empty to disable error tracking
NEXT_PUBLIC_SENTRY_DSN=

# Sentry Auth Token (for source map uploads in CI/CD)
# Get this from Sentry > Settings > Auth Tokens
SENTRY_AUTH_TOKEN=

# Sentry Organization and Project (for CI/CD)
SENTRY_ORG=
SENTRY_PROJECT=

# -----------------------------------------------------------------------------
# Email — Resend [REQUIRED FOR NOMINATION FORM]
# -----------------------------------------------------------------------------
# Resend API key used to send transactional email.
RESEND_API_KEY=
# Verified sender for award nomination confirmation emails.
# The domain (mobisec-conference.com) must be verified in Resend.
RESEND_EMAIL_FROM_AWARDS=awards@mobisec-conference.com
# Verified no-reply sender for presentation upload confirmation emails.
# Same verified domain (mobisec-conference.com).
RESEND_EMAIL_FROM_NOREPLY=noreply@mobisec-conference.com
# Verified sender for QR check-in registration pass emails (initial send + resend).
# Same verified domain (mobisec-conference.com).
RESEND_EMAIL_FROM_REGISTRATION=registration@mobisec-conference.com
# Verified sender for banquet RSVP confirmation emails (submit + admin resend/bulk).
# Same verified domain (mobisec-conference.com).
RESEND_EMAIL_FROM_BANQUET=banquet@mobisec-conference.com
# Recipient for the "Test email" button on /admin/nominations — sends sample
# winner + nominator award emails here for previewing.
TEST_EMAIL=

# -----------------------------------------------------------------------------
# Admin QR Check Ins [REQUIRED FOR QR CHECK INS]
# -----------------------------------------------------------------------------
# Server-only secret used to sign attendee QR credentials.
# Generate with: openssl rand -base64 32
CHECK_IN_QR_SECRET=

# -----------------------------------------------------------------------------
# Cloudflare Turnstile (CAPTCHA) [REQUIRED FOR NOMINATION FORM]
# -----------------------------------------------------------------------------
# Public site key rendered by the Turnstile widget in the browser.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Secret key used to verify Turnstile tokens server-side. Server-only.
TURNSTILE_SECRET_KEY=

# Nomination document uploads use the existing Supabase storage variables above
# (SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY) and the existing "nominations" bucket.

# -----------------------------------------------------------------------------
# Mapbox [OPTIONAL]
# -----------------------------------------------------------------------------
# Public Mapbox token (pk.*) for the Campus Wayfinder map. Must be NEXT_PUBLIC_
# to be available in the browser. Create at https://account.mapbox.com/access-tokens/
# with default public scopes; add a URL restriction for production.
NEXT_PUBLIC_MAPBOX_TOKEN=
