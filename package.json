{
  "name": "mobisec-next",
  "version": "1.0.1",
  "private": true,
  "license": "MIT",
  "keywords": [
    "mobisec",
    "conference",
    "nextjs",
    "typescript",
    "tailwindcss",
    "shadcn-ui"
  ],
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "check": "biome check --write --no-errors-on-unmatched .",
    "check:unsafe": "biome check --write --unsafe",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:ci": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prepare": "husky",
    "commit": "git-cz",
    "release": "standard-version",
    "release:minor": "standard-version --release-as minor",
    "release:major": "standard-version --release-as major",
    "release:patch": "standard-version --release-as patch",
    "release:dry": "standard-version --dry-run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "admin:create": "tsx scripts/create-admin.ts",
    "pdf-fonts:build": "tsx scripts/build-pdf-fonts.ts",
    "presentations:bucket": "tsx scripts/create-presentations-bucket.ts",
    "presentations:backfill": "tsx scripts/backfill-presentation-files.ts",
    "registrations:backfill-ids": "tsx scripts/backfill-registration-ids.ts"
  },
